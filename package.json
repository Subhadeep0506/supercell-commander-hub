{
  "name": "supercellCommanderHub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "web": "bun run keys && vite",
    "web:build": "bun run keys && vite build",
    "web:preview": "vite preview",
    "keys": "node scripts/make-keys.mjs",
    "build:catalog": "node scripts/build-catalog-extra.mjs",
    "build:assets": "node scripts/build-assets.mjs",
    "build:data-ids": "node scripts/build-data-ids.mjs",
    "build:fixtures": "node scripts/make-fixtures.mjs",
    "build:cr-fixtures": "node --use-system-ca --no-warnings scripts/make-cr-fixtures.mjs",
    "build:bs-fixtures": "node scripts/make-bs-fixtures.mjs",
    "build:bs-data": "node --use-system-ca --no-warnings scripts/fetch-bs-data.mjs",
    "fetch:cr-assets": "node --use-system-ca --no-warnings scripts/fetch-cr-assets.mjs",
    "fetch:fankit": "node --use-system-ca --no-warnings scripts/fetch-fankit.mjs",
    "fetch:bs-assets": "node --use-system-ca --no-warnings scripts/fetch-bs-assets.mjs",
    "build:theme": "node scripts/oklch-to-hex.mjs",
    "android": "bun run keys && react-native run-android",
    "ios": "bun run keys && react-native run-ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "start": "bun run keys && react-native start",
    "test": "jest",
    "check:nav": "node scripts/check-nav.mjs",
    "check:screens": "node scripts/check-screens.mjs",
    "check:today": "node scripts/check-today.mjs",
    "check:cr-screens": "node scripts/check-cr-screens.mjs",
    "check:bs-screens": "node scripts/check-bs-screens.mjs",
    "check:cr-api": "node --use-system-ca --no-warnings scripts/check-cr-api.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native/new-app-screen": "0.88.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@tanstack/react-query": "^5.105.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/assets-registry": "0.88.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-module-resolver": "^5.0.3",
    "clash-of-clans-data": "0.19.1",
    "culori": "^4.0.2",
    "dotenv": "^18.0.9",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "puppeteer-core": "^25.16.0",
    "react-test-renderer": "19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
